// PM 에이전트 CI/CD (개발env3 Jenkins → 운영env, 둘 다 폐쇄망).
//
// 흐름: Checkout → Docker build(jfrog base) → Push(jfrog registry) → Deploy.
// REPLACE_ME / credentialsId 값은 사내 환경에 맞게 채운다.

pipeline {
  agent any

  environment {
    JFROG_DOCKER   = 'REPLACE_ME.jfrog.corp.local/docker-remote'      // base image 리모트
    JFROG_REGISTRY = 'REPLACE_ME.jfrog.corp.local/pm-agent'           // 결과 이미지 push 대상
    JFROG_PYPI     = 'https://REPLACE_ME.jfrog.corp.local/artifactory/api/pypi/pypi-remote/simple'
    IMAGE          = "${JFROG_REGISTRY}/pm-agent:${env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build image') {
      steps {
        sh '''
          docker build \
            --build-arg JFROG_DOCKER=${JFROG_DOCKER} \
            --build-arg JFROG_PYPI=${JFROG_PYPI} \
            -t ${IMAGE} \
            -t ${JFROG_REGISTRY}/pm-agent:latest \
            ./pm-agent
        '''
      }
    }

    stage('Push to jfrog') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'jfrog-docker',
                          usernameVariable: 'JF_USER', passwordVariable: 'JF_PASS')]) {
          sh '''
            echo "$JF_PASS" | docker login ${JFROG_REGISTRY%%/*} -u "$JF_USER" --password-stdin
            docker push ${IMAGE}
            docker push ${JFROG_REGISTRY}/pm-agent:latest
          '''
        }
      }
    }

    stage('Deploy (운영 폐쇄망)') {
      steps {
        // 운영 Docker 서버에서 jfrog 이미지 pull 후 재기동.
        // 비밀정보(PG DSN, LLM 토큰)는 이미지가 아니라 배포 시 env로 주입.
        withCredentials([
          string(credentialsId: 'pg-task-dsn',  variable: 'PG_TASK_DSN'),
          string(credentialsId: 'pg-mgmt-dsn',  variable: 'PG_MGMT_DSN'),
          string(credentialsId: 'llm-base-url', variable: 'PM_AGENT_LLM_BASE_URL'),
          string(credentialsId: 'llm-token',    variable: 'PM_AGENT_LLM_TOKEN')
        ]) {
          sh '''
            docker pull ${IMAGE}
            docker rm -f pm-agent || true
            docker run -d --name pm-agent --restart unless-stopped -p 8000:8000 \
              -e PG_TASK_DSN="$PG_TASK_DSN" \
              -e PG_MGMT_DSN="$PG_MGMT_DSN" \
              -e PM_AGENT_LLM_BASE_URL="$PM_AGENT_LLM_BASE_URL" \
              -e PM_AGENT_LLM_TOKEN="$PM_AGENT_LLM_TOKEN" \
              -e PM_AGENT_LLM_API="openai" \
              -e PM_AGENT_MODEL="claude-sonnet-5" \
              ${IMAGE}
          '''
        }
      }
    }
  }
}
