{
  "_doc": "Semantic Layer. 비즈니스 개념 ↔ 실제 시스템/테이블/컬럼 매핑. 에이전트는 raw 테이블이 아니라 이 카탈로그만 보고 추론한다. 새 개념/컬럼을 여기 추가하면 에이전트가 즉시 활용 가능.",

  "systems": {
    "task_mgmt": "과제관리 시스템",
    "mgmt_system": "경영시스템"
  },

  "concepts": {
    "과제": {
      "source": {"system": "task_mgmt", "table": "projects"},
      "key": "task_code",
      "fields": {
        "과제명": "name",
        "사업부": "division",
        "프로그램": "program",
        "단계": "stage",
        "PM": "pm",
        "상태": "status",
        "진척률": "progress_pct",
        "착수일": "start_date",
        "목표일": "target_date"
      }
    },
    "마일스톤": {
      "source": {"system": "task_mgmt", "table": "milestones"},
      "join": "task_code",
      "fields": {
        "게이트": "gate",
        "계획일": "planned_date",
        "실적일": "actual_date"
      }
    },
    "예산": {
      "source": {"system": "mgmt_system", "table": "budget"},
      "note": "과제관리와 코드 체계가 다름 → resolver로 task_code→mgmt_code 변환 후 조인.",
      "resolve_via": "code_crosswalk",
      "join": "mgmt_code",
      "fields": {
        "계획예산": "budget_plan",
        "집행액": "budget_actual",
        "회계연도": "fiscal_year",
        "사업부코드": "division_code"
      }
    }
  },

  "resolution": {
    "code_crosswalk": {
      "_doc": "과제코드 resolution. 두 시스템의 코드 표기가 달라 매핑 필요.",
      "file": "code-crosswalk.csv",
      "from": "task_code",
      "to": "mgmt_code"
    },
    "division_map": {
      "_doc": "사업부 표기 resolution. 과제관리는 한글 약칭, 경영시스템은 코드.",
      "메모리": "MEM",
      "시스템LSI": "SLSI",
      "파운드리": "FND"
    }
  },

  "enums": {
    "_doc": "범주형 컬럼의 유효값. 에이전트 그라운딩용 — 존재하지 않는 값으로 필터링하는 것을 방지.",
    "division": ["메모리", "시스템LSI", "파운드리"],
    "stage": ["선행", "개발", "양산이관"],
    "status": ["정상", "지연", "위험", "보류"],
    "gate": ["착수", "설계", "시제작", "검증", "양산승인"]
  }
}
